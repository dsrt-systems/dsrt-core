# =============================================================================
# DSRT CORE v1.0 — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.

DSRT_CORE_VERSION=1.0.0
DSRT_ENVIRONMENT=development
DSRT_DEBUG=true

DSRT_API_HOST=0.0.0.0
DSRT_API_PORT=8000
DSRT_API_WORKERS=1
DSRT_API_RELOAD=true

DSRT_DATABASE_SCHEMA=dsrt
DSRT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DSRT_DATABASE_MIGRATION_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DSRT_DATABASE_POOL_MIN=2
DSRT_DATABASE_POOL_MAX=10


DSRT_REDIS_HOST=localhost
DSRT_REDIS_PORT=6379
DSRT_REDIS_DB=0
DSRT_REDIS_PASSWORD=

DSRT_SECRET_KEY=CHANGE_ME_MUST_BE_AT_LEAST_32_CHARACTERS
DSRT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DSRT_ALGORITHM=HS256

DSRT_STORAGE_TYPE=local
DSRT_STORAGE_LOCAL_PATH=./storage

DSRT_LOG_LEVEL=DEBUG
DSRT_LOG_FORMAT=json
DSRT_STRUCTURED_LOGGING=true

DSRT_DEFAULT_EXECUTION_TIMEOUT_SECONDS=1800
DSRT_DEFAULT_MAX_MODEL_CALLS=100
DSRT_DEFAULT_MAX_TOOL_CALLS=500
DSRT_DEFAULT_MAX_STORAGE_MB=500