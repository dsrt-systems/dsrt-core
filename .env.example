# =============================================================================
# DSRT CORE v1.0 — Production Environment Configuration
# =============================================================================
# Copy to .env and fill in real values. NEVER commit .env to git.

# --- Core ---
DSRT_CORE_VERSION=1.0.0
DSRT_ENVIRONMENT=production
DSRT_DEBUG=false

# --- API Server ---
DSRT_API_HOST=0.0.0.0
DSRT_API_PORT=8000
DSRT_API_WORKERS=4
DSRT_API_RELOAD=false

# --- Supabase PostgreSQL (Transaction Mode Pooler) ---
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction
DSRT_DATABASE_SCHEMA=dsrt
DSRT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
DSRT_DATABASE_MIGRATION_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DSRT_DATABASE_POOL_MIN=5
DSRT_DATABASE_POOL_MAX=20

# --- Supabase Auth ---
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# --- Supabase Storage (S3-compatible) ---
SUPABASE_STORAGE_BUCKET=dsrt-artifacts
SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1

# --- Upstash Redis (Serverless) ---
# Get from: https://console.upstash.com → Create Redis → REST or TCP
DSRT_REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT:6379
DSRT_REDIS_DB=0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DSRT_SECRET_KEY=GENERATE_A_REAL_64_CHAR_SECRET_KEY_HERE
DSRT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DSRT_ALGORITHM=HS256

# --- Credential Encryption (AES-256) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSRT_CREDENTIAL_ENCRYPTION_KEY=GENERATE_FERNET_KEY_HERE

# --- LLM Provider Keys (BYOK fallback / managed keys) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...

# --- Observability ---
DSRT_LOG_LEVEL=INFO
DSRT_LOG_FORMAT=json
DSRT_STRUCTURED_LOGGING=true

# --- Execution Defaults ---
DSRT_DEFAULT_EXECUTION_TIMEOUT_SECONDS=1800
DSRT_DEFAULT_MAX_MODEL_CALLS=100
DSRT_DEFAULT_MAX_TOOL_CALLS=500
DSRT_DEFAULT_MAX_STORAGE_MB=500

# --- CORS (production Vercel URL) ---
DSRT_CORS_ORIGINS=https://dsrt.vercel.app,https://dsrt-open-arena.vercel.app